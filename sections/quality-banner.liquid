<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 border-b border-gray-100">
  <div class="bg-[#faf9f5] border border-gray-200 rounded-2xl p-5 sm:p-8 shadow-xs">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center text-left">
      <!-- Left Content Side -->
      <div class="md:col-span-7 space-y-4">
        <span class="font-mono text-xs font-bold text-[#c44900] tracking-widest uppercase">
          {{ section.settings.kicker | default: "QUALITY & BOTANICAL PURITY" }}
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl text-[#111315] font-bold leading-tight">
          {{ section.settings.heading | default: "Tested for Heavy Metals, Microbes & Assay Potency" }}
        </h2>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-sans">
          {{ section.settings.text | default: "Every batch manufactured in our Schedule T certified facility undergoes independent NABL laboratory testing before release." }}
        </p>

        <!-- Quality Badges -->
        <div class="flex flex-wrap gap-2 pt-1 font-mono text-[10px] sm:text-xs font-bold text-[#111315]">
          <span class="bg-white border border-gray-200 px-3 py-1 rounded-full shadow-2xs">
            🔬 NABL Lab Tested
          </span>
          <span class="bg-white border border-gray-200 px-3 py-1 rounded-full shadow-2xs">
            🛡️ Schedule T GMP
          </span>
          <span class="bg-white border border-gray-200 px-3 py-1 rounded-full shadow-2xs text-emerald-800">
            🌿 100% Botanical
          </span>
        </div>

        <div class="pt-2">
          <a href="{{ section.settings.button_link | default: '/pages/quality' }}" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#111315] hover:text-[#c44900] underline underline-offset-4 decoration-gray-300 hover:decoration-[#c44900] transition-colors">
            {{ section.settings.button_label | default: "Read our Quality Manifesto" }}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Right Image Side — 100% Pristine Un-cropped Lab Banner Matching Vercel -->
      <div class="md:col-span-5">
        <div class="relative w-full rounded-xl overflow-hidden border border-gray-200 shadow-sm bg-white p-1">
          {% if section.settings.image != blank %}
            <img
              src="{{ section.settings.image | img_url: '800x' }}"
              alt="Quality Control Lab"
              class="w-full h-auto object-contain rounded-lg block"
            />
          {% else %}
            <img
              src="{{ 'banner-lab-quality.jpg' | asset_url }}"
              alt="Regex Remedies Lab Quality"
              class="w-full h-auto object-contain rounded-lg block"
            />
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quality Banner",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "QUALITY & BOTANICAL PURITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tested for Heavy Metals, Microbes & Assay Potency"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every batch manufactured in our Schedule T certified facility undergoes independent NABL laboratory testing before release."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read our Quality Manifesto"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Quality Banner"
    }
  ]
}
{% endschema %}
