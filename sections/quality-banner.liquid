<section class="mx-auto max-w-7xl px-5 lg:px-8 py-6 sm:py-10 border-b border-gray-100">
  <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 sm:p-8 shadow-xs">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center text-left">
      <!-- Left Content Side -->
      <div class="md:col-span-7 space-y-3">
        <span class="font-mono text-xs font-bold text-[#c44900] tracking-widest uppercase">
          {{ section.settings.kicker }}
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl text-[#111315] font-bold leading-tight">
          {{ section.settings.heading }}
        </h2>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-sans">
          {{ section.settings.text }}
        </p>

        <!-- Quality Badges -->
        <div class="flex flex-wrap gap-2 pt-1 font-mono text-[10px] sm:text-xs font-bold text-[#111315]">
          <span class="bg-white border border-gray-200 px-2.5 py-1 rounded-full shadow-2xs">
            🔬 NABL Lab Tested
          </span>
          <span class="bg-white border border-gray-200 px-2.5 py-1 rounded-full shadow-2xs">
            🛡️ Schedule T GMP
          </span>
          <span class="bg-white border border-gray-200 px-2.5 py-1 rounded-full shadow-2xs text-[#25D366]">
            🌿 100% Botanical
          </span>
        </div>

        <div class="pt-4">
          <a href="{{ section.settings.button_link }}" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#111315] hover:text-[#c44900] underline underline-offset-4 decoration-gray-300 hover:decoration-[#c44900] transition-colors">
            {{ section.settings.button_label }}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Right Image Side -->
      <div class="md:col-span-5 h-full min-h-[200px] relative rounded-xl overflow-hidden border border-gray-200">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | img_url: '800x' }}"
            alt="Quality Manufacturing"
            class="absolute inset-0 w-full h-full object-cover"
          />
        {% else %}
          <img
            src="{{ 'banner-lab-quality.jpg' | asset_url }}"
            alt="Regex Remedies Lab Quality"
            class="absolute inset-0 w-full h-full object-cover"
          />
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quality Banner",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "QUALITY & BOTANICAL PURITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tested for Heavy Metals, Microbes & Assay Potency"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every batch manufactured in our Schedule T certified facility undergoes independent NABL laboratory testing before release."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read our Quality Manifesto"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Quality Banner"
    }
  ]
}
{% endschema %}
