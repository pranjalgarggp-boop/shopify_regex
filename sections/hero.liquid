<section class="bg-[#faf9f5] border-b border-gray-200">
  <div class="mx-auto flex max-w-7xl flex-col-reverse lg:flex-row items-center justify-between gap-10 px-5 lg:px-8 py-12 lg:py-20">
    
    <!-- Text Content -->
    <div class="w-full lg:w-5/12 space-y-6 text-center lg:text-left">
      <div class="space-y-4">
        <span class="font-mono text-xs sm:text-sm font-bold tracking-[0.2em] text-[#c44900] uppercase">
          {{ section.settings.kicker }}
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl leading-[1.1] text-[#111315]">
          {{ section.settings.heading }}
        </h1>
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed max-w-lg mx-auto lg:mx-0">
          {{ section.settings.text }}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 justify-center lg:justify-start pt-2">
        <a href="{{ section.settings.button_link }}" class="w-full sm:w-auto bg-[#111315] text-white hover:bg-[#c44900] hover:text-white px-8 py-3.5 font-sans font-medium tracking-wide text-sm transition-colors border border-transparent text-center">
          {{ section.settings.button_label }}
        </a>
        <a href="https://wa.me/918360053594" target="_blank" rel="noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-[#111315] hover:text-[#c44900] hover:border-[#c44900] bg-transparent border border-[#111315] px-8 py-3.5 font-sans font-medium text-sm transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-current"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
          <span>Consult Our Experts</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="grid grid-cols-3 gap-2 sm:gap-4 pt-6 border-t border-gray-200 mt-8">
        <div class="flex flex-col items-center lg:items-start gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#25D366]"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span class="text-[10px] sm:text-xs font-bold text-gray-700 uppercase tracking-wide text-center lg:text-left">Lab Tested<br />Purity</span>
        </div>
        <div class="flex flex-col items-center lg:items-start gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#c44900]"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
          <span class="text-[10px] sm:text-xs font-bold text-gray-700 uppercase tracking-wide text-center lg:text-left">GMP<br />Certified</span>
        </div>
        <div class="flex flex-col items-center lg:items-start gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
          <span class="text-[10px] sm:text-xs font-bold text-gray-700 uppercase tracking-wide text-center lg:text-left">Ayush<br />Approved</span>
        </div>
      </div>
    </div>

    <!-- Image Content -->
    <div class="w-full lg:w-6/12 relative aspect-[4/3] lg:aspect-auto lg:h-[600px] overflow-hidden">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | img_url: 'master' }}"
          alt="Ayurvedic herbs and formulations"
          class="absolute inset-0 w-full h-full object-cover object-center rounded-sm"
        />
      {% else %}
        <img
          src="{{ 'regex-remedies-hero.jpg' | asset_url }}"
          alt="Regex Remedies Hero"
          class="absolute inset-0 w-full h-full object-cover object-center rounded-sm"
        />
      {% endif %}
      <!-- Decorative element -->
      <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-[#c44900]/10 rounded-full blur-2xl"></div>
      <div class="absolute top-4 -left-4 w-24 h-24 bg-[#111315]/5 rounded-full blur-xl"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The Science of Ayurveda"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Natural Remedies for a Better You"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Classical, lab-tested botanical formulations manufactured in our Schedule T GMP certified facility. 100% transparent ingredients, zero heavy metals."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Formulations"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
