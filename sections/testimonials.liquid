<section id="testimonials" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 border-b border-gray-100">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 text-left gap-2">
    <div>
      <span class="font-mono text-xs font-bold text-[#c44900] tracking-widest uppercase">
        {{ section.settings.kicker | default: "WALL OF LOVE" }}
      </span>
      <h2 class="font-serif text-2xl sm:text-3xl text-[#111315] font-bold mt-1">
        {{ section.settings.heading | default: "Trusted by Ayurvedic Physicians & Patients" }}
      </h2>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-left">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="bg-[#faf9f5] border border-gray-200 rounded-xl p-5 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex text-[#c44900] mb-2">
              {% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{% endfor %}
            </div>
            <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-sans italic">
              "{{ block.settings.quote }}"
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-gray-200/60 flex items-center justify-between">
            <span class="font-bold text-xs text-[#111315]">{{ block.settings.author }}</span>
            <span class="font-mono text-[10px] text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded">✓ {{ block.settings.role }}</span>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Fallback Hardcoded Vercel Testimonials -->
      <div class="bg-[#faf9f5] border border-gray-200 rounded-xl p-5 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex text-[#c44900] mb-2">
            {% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{% endfor %}
          </div>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-sans italic">
            "Regex Remedies formulations are standardized to pure active extracts. I routinely recommend Livgex for my patients recovering from sluggish liver function."
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-gray-200/60 flex items-center justify-between">
          <span class="font-bold text-xs text-[#111315]">Dr. Rajesh Sharma, BAMS</span>
          <span class="font-mono text-[10px] text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded">✓ Verified Physician</span>
        </div>
      </div>

      <div class="bg-[#faf9f5] border border-gray-200 rounded-xl p-5 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex text-[#c44900] mb-2">
            {% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{% endfor %}
          </div>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-sans italic">
            "After trying multiple market supplements for chronic acidity, Gasogex provided complete digestive relief in just 10 days without any heavy stomach feeling."
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-gray-200/60 flex items-center justify-between">
          <span class="font-bold text-xs text-[#111315]">Ananya Mehta</span>
          <span class="font-mono text-[10px] text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded">✓ Verified Buyer</span>
        </div>
      </div>

      <div class="bg-[#faf9f5] border border-gray-200 rounded-xl p-5 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex text-[#c44900] mb-2">
            {% for i in (1..5) %}<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{% endfor %}
          </div>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-sans italic">
            "Kabzraj is by far the gentlest overnight laxative formulation I have taken. Zero cramping or harsh discomfort, pure classical herbal results."
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-gray-200/60 flex items-center justify-between">
          <span class="font-bold text-xs text-[#111315]">Vikram Singh</span>
          <span class="font-mono text-[10px] text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded">✓ Verified Buyer</span>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "WALL OF LOVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by Ayurvedic Physicians & Patients"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
