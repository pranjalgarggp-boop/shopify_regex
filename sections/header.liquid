<header class="sticky top-0 z-40 w-full border-b border-[#e5dfd3] bg-[#faf7f1] transition-all duration-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
    
    <!-- Mobile Menu Button -->
    <button class="lg:hidden p-2 -ml-2 text-fg-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="flex items-center gap-2">
      <span class="font-serif text-2xl font-bold tracking-tight text-[#111315]">
        {{ shop.name }}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex lg:items-center lg:gap-8">
      {% for link in linklists.main-menu.links %}
        <a href="{{ link.url }}" class="text-[0.9375rem] font-medium text-[#111315] transition-colors hover:text-[#c44900]">
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>

    <!-- Icons (Search, Account, Cart) -->
    <div class="flex items-center gap-4">
      <a href="{{ routes.search_url }}" class="p-2 text-fg-2 hover:text-black">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
      
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="hidden p-2 text-fg-2 hover:text-black lg:block">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="group relative flex items-center p-2 text-fg-2 hover:text-black">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        {% if cart.item_count > 0 %}
          <span class="absolute right-0 top-0 flex h-4 w-4 items-center justify-center rounded-full bg-[#c44900] text-[10px] font-bold text-white">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
