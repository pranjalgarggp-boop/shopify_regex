<!-- Announcement Bar Marquee -->
<style>
  @keyframes marquee-continuous {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee-continuous {
    display: inline-flex;
    white-space: nowrap;
    animation: marquee-continuous 30s linear infinite;
  }
</style>

<div class="sticky top-0 z-50">
  <div class="bg-[#111315] text-[#ffffff] font-mono shadow-sm overflow-hidden h-8 flex items-center w-full">
    <div class="animate-marquee-continuous font-bold tracking-wider py-0.5">
      {% for i in (1..4) %}
      <span class="flex items-center gap-6 whitespace-nowrap px-4 text-[10px] sm:text-xs">
        <span class="flex items-center gap-1.5 text-[#c4923e]">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>AYUSH LICENCE: <strong class="text-white">PB/AY/000000</strong></span>
        </span>
        <span class="text-white/30">•</span>
        <span class="text-white font-bold">
          FREE EXPRESS SHIPPING ON ORDERS OVER <strong class="text-[#c4923e]">₹599</strong>
        </span>
        <span class="text-white/30">•</span>
        <span class="text-[#25D366] font-bold">OFFICIAL WHATSAPP SUPPORT</span>
        <span class="text-white/30">•</span>
        <span class="text-[#c4923e]">SCHEDULE T GMP CERTIFIED</span>
        <span class="text-white/30">•</span>
      </span>
      {% endfor %}
    </div>
  </div>

  <!-- Main Header -->
  <header class="w-full bg-white/95 backdrop-blur-md transition-all duration-200 border-b border-gray-200 shadow-sm">
    <div class="mx-auto flex h-14 sm:h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:px-6 lg:px-8">
      
      <!-- Mobile Menu Button -->
      <button id="MobileMenuOpen" class="lg:hidden p-2 -ml-2 text-gray-700 hover:text-black focus:outline-none" aria-label="Open Mobile Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="flex items-center gap-2 group">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ shop.name }}" class="w-8 h-8 sm:w-9 sm:h-9 object-contain" />
        {% else %}
          <img src="{{ 'emblem-ink.png' | asset_url }}" alt="{{ shop.name }}" class="w-8 h-8 sm:w-9 sm:h-9 object-contain" />
        {% endif %}
        <div>
          <span class="font-serif text-base sm:text-lg font-bold text-[#111315] block leading-none">
            Regex Remedies
          </span>
          <span class="font-mono text-[8px] sm:text-[9px] tracking-widest text-[#c4923e] uppercase block font-bold leading-none mt-0.5">
            Natural Ayurvedic Remedies
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8">
        {% assign menu = linklists[section.settings.menu] %}
        {% if menu.links != blank %}
          {% for link in menu.links %}
            <a href="{{ link.url }}" class="text-[13px] font-bold text-[#111315] transition-colors hover:text-[#c44900]">
              {{ link.title }}
            </a>
          {% endfor %}
        {% else %}
          <a href="{{ routes.all_products_collection_url }}" class="text-[13px] font-bold text-[#111315] hover:text-[#c44900]">Remedies</a>
          <a href="#overview" class="text-[13px] font-bold text-[#111315] hover:text-[#c44900]">Quality</a>
          <a href="#faqs" class="text-[13px] font-bold text-[#111315] hover:text-[#c44900]">FAQs</a>
        {% endif %}
      </nav>

      <!-- Right Actions -->
      <div class="flex items-center gap-2 sm:gap-3 justify-end">
        <!-- Search Button (Desktop) -->
        <button class="hidden sm:flex items-center gap-2 text-xs font-mono font-bold text-gray-500 bg-gray-100 hover:bg-gray-200 hover:text-black px-3 py-1.5 rounded-full transition-colors border border-gray-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <span>Search</span>
        </button>

        <!-- WhatsApp Support Link -->
        <a href="https://wa.me/{{ section.settings.whatsapp_number }}" target="_blank" class="p-2 text-[#25D366] hover:bg-[#25D366]/10 rounded-full transition-colors" title="WhatsApp Support">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </a>

        <!-- Cart Drawer Icon -->
        <a href="{{ routes.cart_url }}" class="group relative flex items-center p-2 text-gray-700 hover:text-black">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          {% if cart.item_count > 0 %}
            <span class="absolute right-0 top-0 flex h-4 w-4 items-center justify-center rounded-full bg-[#c44900] text-[10px] font-bold text-white">
              {{ cart.item_count }}
            </span>
          {% endif %}
        </a>
      </div>

    </div>
  </header>
</div>

<!-- Mobile Navigation Drawer Overlay -->
<div id="MobileMenuDrawer" class="fixed inset-0 z-[100] hidden bg-black/50 backdrop-blur-xs transition-opacity">
  <div class="fixed inset-y-0 left-0 w-[80%] max-w-sm bg-white p-6 shadow-2xl flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
        <div class="flex items-center gap-2">
          <img src="{{ 'emblem-ink.png' | asset_url }}" alt="Logo" class="w-7 h-7 object-contain" />
          <span class="font-serif text-base font-bold text-[#111315]">Regex Remedies</span>
        </div>
        <button id="MobileMenuClose" class="p-2 text-gray-500 hover:text-black" aria-label="Close Menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
        </button>
      </div>

      <nav class="flex flex-col gap-4 font-serif text-lg font-bold text-[#111315]">
        <a href="{{ routes.all_products_collection_url }}" class="hover:text-[#c44900] transition-colors py-1">Catalogue (All 5 Remedies)</a>
        <a href="/#overview" class="hover:text-[#c44900] transition-colors py-1">Quality Manifesto</a>
        <a href="/#testimonials" class="hover:text-[#c44900] transition-colors py-1">Wall of Love</a>
        <a href="/#faqs" class="hover:text-[#c44900] transition-colors py-1">Frequently Asked Questions</a>
      </nav>
    </div>

    <div class="pt-6 border-t border-gray-100 space-y-3 font-mono text-xs text-gray-500">
      <a href="https://wa.me/{{ section.settings.whatsapp_number }}" target="_blank" class="flex items-center gap-2 text-[#25D366] font-bold bg-[#25D366]/10 p-3 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        <span>WhatsApp Doctor Support</span>
      </a>
      <p>Schedule T Certified Ayurvedic Facility</p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const openBtn = document.getElementById('MobileMenuOpen');
    const closeBtn = document.getElementById('MobileMenuClose');
    const drawer = document.getElementById('MobileMenuDrawer');

    if (openBtn && drawer) {
      openBtn.addEventListener('click', function() {
        drawer.classList.remove('hidden');
      });
    }
    if (closeBtn && drawer) {
      closeBtn.addEventListener('click', function() {
        drawer.classList.add('hidden');
      });
    }
    if (drawer) {
      drawer.addEventListener('click', function(e) {
        if (e.target === drawer) {
          drawer.classList.add('hidden');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number",
      "default": "918360053594"
    }
  ]
}
{% endschema %}
