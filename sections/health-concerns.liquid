<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 border-b border-gray-100">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 text-left gap-2">
    <div>
      <span class="font-mono text-xs font-bold text-[#c44900] tracking-widest uppercase">
        {{ section.settings.kicker | default: "TARGETED CARE" }}
      </span>
      <h2 class="font-serif text-2xl sm:text-3xl text-[#111315] font-bold mt-1">
        {{ section.settings.heading | default: "Remedies by Health Concern" }}
      </h2>
      <p class="text-xs sm:text-sm text-gray-600 mt-1">
        {{ section.settings.subtitle | default: "Select your health focus area to discover classical formulas." }}
      </p>
    </div>
  </div>

  <!-- Horizontal Touch Carousel for Mobile & Desktop -->
  <div class="flex gap-4 overflow-x-auto no-scrollbar snap-x snap-mandatory pb-4 text-left -mx-4 px-4 sm:mx-0 sm:px-0">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="w-[260px] sm:w-[280px] shrink-0 snap-start group bg-white border border-gray-200 hover:border-[#c44900] rounded-xl p-4 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold text-sm text-[#c44900] font-deva">
                {{ block.settings.hindi_title }}
              </span>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-gray-100 text-gray-700 font-bold">
                {{ block.settings.remedy_count }} Remedy
              </span>
            </div>

            <h3 class="font-serif text-lg text-[#111315] mb-1 group-hover:text-[#c44900] transition-colors font-bold">
              {{ block.settings.title }}
            </h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-3">
              {{ block.settings.blurb }}
            </p>
          </div>

          <div class="pt-2.5 border-t border-gray-100 flex items-center justify-between font-mono text-xs text-[#111315] font-bold">
            <span>View Remedies</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform text-[#c44900]"><path d="m9 18 6-6-6-6"/></svg>
          </div>
        </a>
      {% endfor %}
    {% else %}
