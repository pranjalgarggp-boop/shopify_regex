      <a href="/products/lucogex" class="w-[260px] sm:w-[280px] shrink-0 snap-start group bg-white border border-gray-200 hover:border-[#c44900] rounded-xl p-4 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-sm text-[#c44900] font-deva">स्त्री स्वास्थ्य</span>
            <span class="font-mono text-[10px] px-2 py-0.5 rounded-full bg-gray-100 text-gray-700 font-bold">1 Remedy</span>
          </div>
          <h3 class="font-serif text-lg text-[#111315] mb-1 group-hover:text-[#c44900] transition-colors font-bold">Women's Health</h3>
