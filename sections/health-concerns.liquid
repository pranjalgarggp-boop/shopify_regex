        </div>
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Health Concerns",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "TARGETED CARE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Remedies by Health Concern"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Select your health focus area to discover classical formulas."
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern Card",
      "settings": [
        {
          "type": "text",
          "id": "hindi_title",
          "label": "Hindi Devanagari Title"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "blurb",
          "label": "Blurb"
        },
        {
          "type": "text",
          "id": "remedy_count",
          "label": "Remedy Count",
          "default": "1"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Health Concerns"
    }
  ]
}
{% endschema %}
