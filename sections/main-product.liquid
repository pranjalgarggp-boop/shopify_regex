<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-2 sm:pt-6 text-left">
  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="text-xs font-mono text-gray-500 mb-3">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li>
        <a href="{{ routes.all_products_collection_url }}" class="hover:text-[#c44900]">Remedies</a>
      </li>
      <li aria-hidden="true">/</li>
      {% if collection %}
        <li>
          <a href="{{ collection.url }}" class="hover:text-[#c44900]">{{ collection.title }}</a>
        </li>
        <li aria-hidden="true">/</li>
      {% endif %}
      <li aria-current="page" class="font-bold text-[#111315]">
        {{ product.title }}
      </li>
    </ol>
  </nav>

  <!-- ── Buy Block (Premium Editorial Mobile-Optimized Layout) ─────────────────────────── -->
  <div class="grid gap-6 lg:gap-16 lg:grid-cols-12 items-start">
    
    <!-- Gallery Box (object-contain so bottle is centered & never cropped) -->
    <div class="lg:col-span-6 w-full">
      <div class="relative w-full aspect-square max-h-[360px] sm:max-h-none rounded-2xl overflow-hidden bg-[#faf7f1] border border-gray-200/80 p-4 flex items-center justify-center mb-3">
        {% if product.featured_image %}
          <img 
            src="{{ product.featured_image | img_url: 'master' }}" 
            alt="{{ product.featured_image.alt | escape }}" 
            class="max-h-full max-w-full h-auto w-auto object-contain drop-shadow-md"
            id="MainProductImage"
          >
        {% else %}
          <img 
            src="{{ 'product-shilajit.jpg' | asset_url }}" 
            alt="{{ product.title }}" 
            class="max-h-full max-w-full h-auto w-auto object-contain drop-shadow-md"
            id="MainProductImage"
          >
        {% endif %}
        
        <!-- Targeted Care Badge -->
        <div class="absolute left-3 top-3 z-10 flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1 text-[10px] sm:text-xs font-bold tracking-widest text-[#111315] shadow-xs backdrop-blur-md">
          <span class="flex h-1.5 w-1.5 rounded-full bg-[#c44900]"></span>
          TARGETED CARE
        </div>
      </div>
      
      <!-- Gallery Thumbnails (Max 4 thumbnails for mobile optimization) -->
      {% if product.images.size > 1 %}
        <div class="flex gap-2.5 overflow-x-auto no-scrollbar pb-1">
          {% for image in product.images limit: 4 %}
            <button class="shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-lg overflow-hidden border-2 focus:outline-none focus:border-[#c44900] bg-[#faf7f1] p-1 {% if forloop.first %}border-[#c44900]{% else %}border-transparent{% endif %}" onclick="document.getElementById('MainProductImage').src = '{{ image | img_url: 'master' }}';">
              <img src="{{ image | img_url: '200x' }}" alt="{{ image.alt | escape }}" class="w-full h-full object-contain">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Details -->
    <div class="lg:col-span-6 space-y-5 lg:pt-2">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="font-mono text-xs text-[#c44900] font-bold uppercase tracking-widest">
            Digestive Health & Metabolism
          </span>
          <span class="font-deva text-xs sm:text-sm font-bold text-[#c44900] px-3 py-0.5 rounded-full bg-[#faf7f1] border border-gray-200">
            आयुर्वेद
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#111315] leading-tight">{{ product.title }}</h1>
        <p class="text-sm sm:text-base text-gray-600 font-sans mt-2">
          Classical High-Potency Ayurvedic Extract · Standardized Actives
        </p>
      </div>

      <!-- Rating & Badges -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 border-y border-gray-100 py-3">
        <div class="flex items-center gap-1 text-[#c44900]">
          {% for i in (1..5) %}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          {% endfor %}
          <span class="text-xs font-bold ml-1 text-[#111315]">4.9 (124 Reviews)</span>
        </div>
        <span class="text-gray-300">•</span>
        <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-0.5 text-[11px] font-bold text-blue-700">
          General Wellness
        </span>
        <span class="text-gray-300">•</span>
        <span class="text-[11px] font-mono font-bold text-gray-600 uppercase">≈ 30 Days Pack</span>
      </div>

      <!-- Price Box & Add To Cart -->
      <div>
        <div class="flex items-baseline gap-3 mb-1">
          <span class="font-sans text-2xl sm:text-3xl font-bold text-[#111315]">
            {% if product.price > 0 %}{{ product.price | money }}{% else %}₹1,499{% endif %}
          </span>
          {% if product.compare_at_price > product.price %}
            <span class="font-sans text-base text-gray-400 line-through">
              {{ product.compare_at_price | money }}
            </span>
          {% else %}
            <span class="font-sans text-base text-gray-400 line-through">₹1,999</span>
          {% endif %}
        </div>
        <p class="text-xs text-gray-500 font-sans mb-4">
          Pack of 60 capsules · Inclusive of all taxes
        </p>

        <div>
          {% form 'product', product %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            
            <div class="flex flex-col sm:flex-row gap-3 mb-3">
              <div class="flex h-12 w-full sm:w-32 items-center justify-between rounded bg-white border border-gray-300 px-4">
                <button type="button" class="text-gray-500 hover:text-black font-bold text-lg" onclick="this.nextElementSibling.stepDown()">-</button>
                <input type="number" name="quantity" value="1" min="1" class="w-12 text-center text-sm font-bold bg-transparent border-none outline-none appearance-none" />
                <button type="button" class="text-gray-500 hover:text-black font-bold text-lg" onclick="this.previousElementSibling.stepUp()">+</button>
              </div>
              <button
                type="submit"
                name="add"
                class="flex h-12 flex-1 items-center justify-center rounded bg-[#111315] px-6 text-sm font-bold text-white transition-colors hover:bg-[#c44900] shadow-md"
              >
                Add to Cart
              </button>
            </div>
          {% endform %}
        </div>
      </div>

      <!-- Trust Badges -->
      <div class="space-y-2 text-xs font-mono text-gray-500 pt-4 border-t border-gray-100">
        <p class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#111315] shrink-0"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5"/><path d="M14 17h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
          <span>Dispatched within 24 hours. Express Delivery 2-4 Days.</span>
        </p>
        <p class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#111315] shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          <span>AYUSH Licensed & Schedule T Certified Manufacturing</span>
        </p>
      </div>
    </div>
  </div>
</div>

