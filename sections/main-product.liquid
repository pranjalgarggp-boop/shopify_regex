          <span class="font-deva text-base font-bold text-[#c44900] px-3 py-0.5 rounded-full border border-gray-200">
            आयुर्वेद
          </span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-[#111315] leading-[1.1]">{{ product.title }}</h1>
        <p class="text-base sm:text-lg text-gray-600 font-sans mt-3">
          Classical High-Potency Ayurvedic Extract · Standardized Actives
        </p>
      </div>

      <!-- Rating & Badges -->
      <div class="flex flex-wrap items-center gap-3 border-y border-gray-100 py-4">
        <div class="flex items-center gap-1 text-[#c44900]">
          {% for i in (1..5) %}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
