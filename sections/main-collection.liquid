<div class="mx-auto max-w-7xl px-5 lg:px-8 pt-10 md:pt-14 pb-20">
  
  <header class="max-w-2xl mb-14">
    <p class="font-mono text-xs font-bold text-[#c44900] tracking-widest uppercase">The range</p>
    <h1 class="font-serif text-4xl sm:text-5xl font-bold text-[#111315] mt-5 leading-[1.1]">
      Five remedies.
    </h1>
    <p class="mt-5 text-base sm:text-lg text-gray-600 font-sans leading-relaxed">
      That is the whole catalogue. Each one is a classical Ayurvedic formulation, manufactured in our Schedule T GMP certified facility. Filter by concern to find exactly what you need.
    </p>
  </header>

  <div class="flex flex-col lg:flex-row gap-10 items-start">
    
    <!-- Sidebar Filtering -->
    <aside class="w-full lg:w-64 shrink-0 space-y-8">
      <div class="flex items-center gap-2 font-serif text-lg font-bold text-[#111315] mb-4 pb-2 border-b border-gray-100">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg>
        Filters
      </div>
      
      <!-- Fake filtering UI to match Vercel style visually - in a real Shopify build you'd loop through collection.filters -->
      <div class="space-y-4">
        <h3 class="text-xs font-mono font-bold text-gray-500 uppercase tracking-widest">Concern</h3>
        <ul class="space-y-2">
          <li>
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" class="w-4 h-4 rounded border-gray-300 text-[#111315] focus:ring-[#111315]" />
              <span class="text-sm text-gray-700 group-hover:text-black">Digestion & Gut Health</span>
            </label>
          </li>
          <li>
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" class="w-4 h-4 rounded border-gray-300 text-[#111315] focus:ring-[#111315]" />
              <span class="text-sm text-gray-700 group-hover:text-black">Liver Support</span>
            </label>
          </li>
          <li>
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" class="w-4 h-4 rounded border-gray-300 text-[#111315] focus:ring-[#111315]" />
              <span class="text-sm text-gray-700 group-hover:text-black">Energy & Vitality</span>
            </label>
          </li>
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-mono font-bold text-gray-500 uppercase tracking-widest">Form</h3>
        <ul class="space-y-2">
          <li>
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" class="w-4 h-4 rounded border-gray-300 text-[#111315] focus:ring-[#111315]" />
              <span class="text-sm text-gray-700 group-hover:text-black">Capsule</span>
            </label>
          </li>
          <li>
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" class="w-4 h-4 rounded border-gray-300 text-[#111315] focus:ring-[#111315]" />
              <span class="text-sm text-gray-700 group-hover:text-black">Tablet</span>
            </label>
          </li>
        </ul>
      </div>
    </aside>

    <!-- Product Grid -->
    <div class="flex-1">
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-gray-100">
        <p class="text-sm text-gray-500 font-mono">{{ collection.products_count }} Products</p>
        <select class="text-sm border-gray-200 rounded-md py-1.5 pl-3 pr-8 text-gray-700 focus:border-[#111315] focus:ring-[#111315]">
          <option>Relevance</option>
          <option>Price: Low to High</option>
          <option>Price: High to Low</option>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <div class="col-span-full py-20 text-center">
            <p class="text-gray-500">No products found in this collection.</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
