<section id="faqs" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12 border-b border-gray-100">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 text-left gap-2">
    <div>
      <span class="font-mono text-xs font-bold text-[#c44900] tracking-widest uppercase">
        {{ section.settings.kicker | default: "FAQ" }}
      </span>
      <h2 class="font-serif text-2xl sm:text-3xl text-[#111315] font-bold mt-1">
        {{ section.settings.heading | default: "Frequently Asked Questions" }}
      </h2>
    </div>
  </div>

  <div class="space-y-3 text-left">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <details class="bg-[#faf9f5] border border-gray-200 rounded-xl p-4 sm:p-5 group">
          <summary class="font-serif font-bold text-sm sm:text-base text-[#111315] cursor-pointer flex items-center justify-between">
            <span>{{ block.settings.question }}</span>
            <span class="text-base transition-transform group-open:rotate-180">+</span>
          </summary>
          <p class="text-xs sm:text-sm text-gray-600 mt-3 leading-relaxed font-sans">
            {{ block.settings.answer }}
          </p>
        </details>
      {% endfor %}
    {% else %}
      <!-- Fallback Hardcoded Vercel FAQs -->
      <details class="bg-[#faf9f5] border border-gray-200 rounded-xl p-4 sm:p-5 group">
        <summary class="font-serif font-bold text-sm sm:text-base text-[#111315] cursor-pointer flex items-center justify-between">
          <span>Are Regex Remedies products Schedule T GMP Certified?</span>
          <span class="text-base transition-transform group-open:rotate-180">+</span>
        </summary>
        <p class="text-xs sm:text-sm text-gray-600 mt-3 leading-relaxed font-sans">
          Yes. All Regex Remedies products are manufactured under strict Schedule T GMP certified facilities with independent NABL lab testing for heavy metals, microbial assay, and active polyphenol potency.
        </p>
      </details>

      <details class="bg-[#faf9f5] border border-gray-200 rounded-xl p-4 sm:p-5 group">
        <summary class="font-serif font-bold text-sm sm:text-base text-[#111315] cursor-pointer flex items-center justify-between">
          <span>How long does delivery take across India?</span>
          <span class="text-base transition-transform group-open:rotate-180">+</span>
        </summary>
        <p class="text-xs sm:text-sm text-gray-600 mt-3 leading-relaxed font-sans">
          All orders are dispatched within 24 hours. Express shipping typically delivers within 2–4 business days across major cities in India. Orders over ₹599 receive free express shipping.
        </p>
      </details>

      <details class="bg-[#faf9f5] border border-gray-200 rounded-xl p-4 sm:p-5 group">
        <summary class="font-serif font-bold text-sm sm:text-base text-[#111315] cursor-pointer flex items-center justify-between">
          <span>How can I speak to an Ayurvedic doctor regarding my dosage?</span>
          <span class="text-base transition-transform group-open:rotate-180">+</span>
        </summary>
        <p class="text-xs sm:text-sm text-gray-600 mt-3 leading-relaxed font-sans">
          You can click the floating green WhatsApp button on the bottom-right corner of the website to connect directly with our certified BAMS Ayurvedic physicians for a free dosage consultation.
        </p>
      </details>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "FAQs",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs"
    }
  ]
}
{% endschema %}
