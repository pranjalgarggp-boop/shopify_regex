<section class="mx-auto max-w-3xl px-5 lg:px-8 py-10 sm:py-16 border-b border-gray-100">
  <div class="text-center mb-8">
    <span class="font-mono text-xs font-bold text-[#c44900] tracking-widest uppercase">
      FAQ
    </span>
    <h2 class="font-serif text-2xl sm:text-3xl text-[#111315] font-bold mt-2">
      Frequently Asked Questions
    </h2>
  </div>

  <div class="space-y-4">
    {% for block in section.blocks %}
      <details class="group border border-gray-200 rounded-lg bg-white overflow-hidden [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-4 sm:p-5 text-[#111315] font-bold text-sm sm:text-base">
          {{ block.settings.question }}
          <span class="transition duration-300 group-open:-rotate-180">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>
        <div class="px-4 sm:px-5 pb-4 sm:pb-5 text-xs sm:text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-3">
          {{ block.settings.answer }}
        </div>
      </details>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "FAQs",
  "settings": [],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are these medicines safe?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes, our classical formulations are 100% safe."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
